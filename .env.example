# Optional. When set, the contact and waitlist forms POST JSON to this URL:
#   { "form": "contact" | "waitlist", ...fields }
# Leave unset to use the built-in placeholder handler in src/lib/submitForm.ts.
NEXT_PUBLIC_FORM_ENDPOINT=

# Canonical site URL for metadata, canonicals, sitemap and OG tags.
# On Vercel this is derived automatically; set it to use a custom domain.
NEXT_PUBLIC_SITE_URL=
